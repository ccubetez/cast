# ── App ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Solana ───────────────────────────────────────────
# Кластер mainnet-beta (торговля с Phase 8). devnet больше не используется.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# необязательно: свой RPC для чтения баланса на клиенте (по умолчанию публичный mainnet RPC)
NEXT_PUBLIC_SOLANA_RPC_URL=
# Helius RPC с ключом — server-side only (свопы, балансы, подтверждения)
HELIUS_API_KEY=

# ── Helius (Phase 3+: risk checks, DAS, RPC) ─────────
# Developer plan. ТОЛЬКО server-side, никогда не NEXT_PUBLIC_.
HELIUS_API_KEY=
# Резолвится из ключа, можно не трогать:
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# ── Market data providers ────────────────────────────
# Phase 2: подтверждённый публичный base URL StonkFun
STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1
# STONKFUN_API_KEY=
# DEXSCREENER_API_BASE=https://api.dexscreener.com
# BIRDEYE_API_KEY=

# Интервал ingestion, секунды
INGESTION_INTERVAL_SEC=45
# TTL hot-кеша пулов Ocean, секунды
OCEAN_CACHE_TTL_SEC=30

# ── Jupiter ──────────────────────────────────────────
JUPITER_QUOTE_API=https://quote-api.jup.ag/v6
JUPITER_PRICE_API=https://price.jup.ag/v6
# дефолтный slippage, bps (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100
# максимально допустимый price impact, bps — выше → токен исключается
MAX_PRICE_IMPACT_BPS=1500

# ── Filtering / risk ─────────────────────────────────
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_24H_USD=1000
MIN_TOKEN_AGE_MINUTES=30

# ── CAST limits ──────────────────────────────────────
# hard cap на сумму одного CAST, SOL (финансовая безопасность)
MAX_CAST_SOL=5
MIN_CAST_SOL=0.01
# дефолтные границы позиции внутри Catch (доля от суммы)
DEFAULT_MIN_POSITION_PCT=4
DEFAULT_MAX_POSITION_PCT=30

# ── Database / cache ─────────────────────────────────
# docker compose (cast-db), порт 5433 — 5432 занят локальным postgres
DATABASE_URL=postgresql://cast:cast@localhost:5433/cast
REDIS_URL=redis://localhost:6379

# ── API security ─────────────────────────────────────
# HMAC-секрет для сессионных токенов (sign-in with wallet). Сгенерировать: openssl rand -hex 32
AUTH_SECRET=
# rate limit: запросов в минуту на IP
API_RATE_LIMIT_RPM=60
